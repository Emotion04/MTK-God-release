// 这是 remote-config 的可编辑源文件：支持 // 和 /* */ 注释，可以随手写备注。
// 发布时由 tools/publish_local.py 去掉注释，生成 release/public/remote-config.json 再上传。
// 字段说明见 release/remote-config.md。
{
  "schema": 1, // 结构版本，固定 1；App 不认识就忽略整份配置
  "version": 1, // 每次修改 +1；App 只接受比缓存高的版本
  "channel": "stable", // stable 或 canary，App 只应用自己渠道

  "texts": {
    "notice": "", // 首页/设置公告，空字符串 = 用内置文案
    "download_button": "下载新版",
    "download_hint": ""
  },

  "flags": {
    "enable_update_check": true, // 关掉后 App 不再检查更新
    "show_lab": true // 实验室入口是否显示
  },

  // 必须是 https，和 update.json 里的 url 保持一致
  "downloadUrl": "https://changelog.a0v0a.cn/MTK-God/app-release.apk"
}
